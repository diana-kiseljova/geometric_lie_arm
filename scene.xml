<mujoco model="panda_scene">
  <!-- Подключаем внешний XML-файл с описанием робота Franka Panda -->
  <include file="panda.xml"/>

  <!-- Настройки сцены для камеры/визуализации:
       center — примерный центр сцены,
       extent — масштаб сцены -->
  <statistic center="0.3 0 0.4" extent="1"/>

  <!-- Визуальные настройки рендера -->
  <visual>
    <!-- Главный свет, который движется вместе с камерой -->
    <headlight diffuse="0.6 0.6 0.6"
               ambient="0.3 0.3 0.3"
               specular="0 0 0"/>

    <!-- Цвет тумана/дымки на фоне -->
    <rgba haze="0.15 0.25 0.35 1"/>

    <!-- Начальный угол обзора камеры -->
    <global azimuth="120" elevation="-20"/>
  </visual>

  <!-- Блок ресурсов: текстуры, материалы и т.п. -->
  <asset>
    <!-- Фоновая skybox-текстура: градиент от голубого к чёрному -->
    <texture type="skybox"
             builtin="gradient"
             rgb1="0.3 0.5 0.7"
             rgb2="0 0 0"
             width="512"
             height="3072"/>

    <!-- Текстура пола в виде шахматной сетки -->
    <texture type="2d"
             name="groundplane"
             builtin="checker"
             mark="edge"
             rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8"
             width="300"
             height="300"/>

    <!-- Материал пола, использующий текстуру groundplane -->
    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.2"/>
  </asset>

  <!-- worldbody содержит все объекты, расположенные в мире -->
  <worldbody>
    <!-- Направленный источник света сверху -->
    <light pos="0 0 1.5"
           dir="0 0 -1"
           directional="true"/>

    <!-- Плоскость пола -->
    <geom name="floor"
          type="plane"
          size="0 0 0.05"
          material="groundplane"/>

  </worldbody>
</mujoco>